name: "class-predictor"
backend: "python"
max_batch_size: 0

input [
    {
        name: "LOGITS"
        data_type: TYPE_FP32
        dims: [ -1, 2 ]
    }
]

output [
    {
        name: "PREDICTED_CLASS"
        data_type: TYPE_INT32
        dims: [ -1 ]
    }
]

instance_group [
    {
        count: 4
        kind: KIND_CPU
    }
]
