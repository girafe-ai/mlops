name: "image-preprocessor"
backend: "python"
max_batch_size: 0

input [
    {
        name: "IMAGE_PATH"
        data_type: TYPE_STRING
        dims: [ -1 ]
    }
]

output [
    {
        name: "PREPROCESSED_IMAGE"
        data_type: TYPE_FP32
        dims: [ -1, 3, 96, 96 ]
    }
]

instance_group [
    {
        count: 4
        kind: KIND_CPU
    }
]
