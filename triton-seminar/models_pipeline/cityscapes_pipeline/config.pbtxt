name: "cityscapes_pipeline"
platform: "ensemble"
max_batch_size: 0

input [
  {
    name: "IMAGE_BYTES"
    data_type: TYPE_UINT8
    dims: [ -1 ]
  }
]

output [
  {
    name: "PRED_MASK"
    data_type: TYPE_UINT8
    dims: [ 1, 1024, 2048 ]
  },
  {
    name: "COLOR_MASK"
    data_type: TYPE_UINT8
    dims: [ 1, 1024, 2048, 3 ]
  },
  {
    name: "CLASS_HISTOGRAM"
    data_type: TYPE_UINT64
    dims: [ 19 ]
  },
  {
    name: "MEAN_CONFIDENCE"
    data_type: TYPE_FP32
    dims: [ 1 ]
  }
]

ensemble_scheduling {
  step [
    {
      model_name: "image_preprocess"
      model_version: -1
      input_map {
        key: "IMAGE_BYTES"
        value: "IMAGE_BYTES"
      }
      output_map {
        key: "IMAGE_TENSOR"
        value: "IMAGE_TENSOR"
      }
    },
    {
      model_name: "cityscapes_embedder"
      model_version: -1
      input_map {
        key: "input"
        value: "IMAGE_TENSOR"
      }
      output_map {
        key: "logits"
        value: "LOGITS"
      }
    },
    {
      model_name: "segmentation_postprocess"
      model_version: -1
      input_map {
        key: "LOGITS"
        value: "LOGITS"
      }
      output_map {
        key: "PRED_MASK"
        value: "PRED_MASK"
      }
      output_map {
        key: "COLOR_MASK"
        value: "COLOR_MASK"
      }
      output_map {
        key: "CLASS_HISTOGRAM"
        value: "CLASS_HISTOGRAM"
      }
      output_map {
        key: "MEAN_CONFIDENCE"
        value: "MEAN_CONFIDENCE"
      }
    }
  ]
}
